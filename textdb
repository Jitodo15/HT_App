SELECT m.day_of_week, m.meal_type, s.name AS section, mi.name AS item, mi.description, mi.price
FROM Meal m
JOIN MenuItem mi ON m.id = mi.meal_id
JOIN Section s ON mi.section_id = s.id
WHERE m.day_of_week = 'Monday' AND m.meal_type = 'Breakfast'
ORDER BY s.name, mi.id;
