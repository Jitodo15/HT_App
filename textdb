-- Table for meal sessions
CREATE TABLE Meal (
    id SERIAL PRIMARY KEY,
    day_of_week VARCHAR(10) NOT NULL,  -- e.g., 'Monday'
    meal_type VARCHAR(10) NOT NULL,      -- e.g., 'Breakfast'
    CHECK (
         (day_of_week IN ('Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday') AND meal_type IN ('Breakfast', 'Lunch', 'Dinner'))
      OR (day_of_week IN ('Saturday', 'Sunday') AND meal_type IN ('Brunch', 'Dinner'))
    )
);

-- Table for cafeteria sections
CREATE TABLE Section (
    id SERIAL PRIMARY KEY,
    name VARCHAR(50) NOT NULL           -- e.g., 'Main', 'Grill', 'Sandwich', 'Drinks'
);

-- Table for menu items
CREATE TABLE MenuItem (
    id SERIAL PRIMARY KEY,
    meal_id INT NOT NULL REFERENCES Meal(id) ON DELETE CASCADE,
    section_id INT NOT NULL REFERENCES Section(id),
    name VARCHAR(100) NOT NULL,
    description TEXT,
    price DECIMAL(5,2)
);
